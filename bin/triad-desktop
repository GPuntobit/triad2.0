#!/bin/sh
# Sessione desktop POSIX: il seed richiede un file e non offre ancora un REPL.
# Solo i programmi composti da println di valori letterali partono in automatico.
# Ogni altro programma richiede :core o :logic; nessuna scelta automatica Full/S1.
# Separata da bin/triad per preservare exit code e delega diretta del launcher.
set -u
self=$0
while [ -L "$self" ]; do
    link=$(readlink "$self" 2>/dev/null) || break
    case $link in
        /*) self=$link ;;
        *) self=$(dirname "$self")/$link ;;
    esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd -P) || exit 1

profile=
if [ "${1:-}" = "--logic" ]; then
    profile=logic
    shift
elif [ "${1:-}" = "--core" ]; then
    profile=core
    shift
elif [ "${1:-}" = "--auto" ]; then
    printf 'Profilo automatico non disponibile: usa --core oppure --logic.\n' >&2
    exit 2
fi

# Controllo conservativo: solo println di letterali, commenti e righe vuote.
# Non eseguiamo un sorgente arbitrario per il solo fatto che contiene "println".
# POSIX awk: nessuna valutazione o interpretazione da parte della shell.
is_print_only_source() {
    LC_ALL=C awk '
        BEGIN { seen = 0 }
        /^[[:space:]]*($|#)/ { next }
        /^[[:space:]]*println\([[:space:]]*\)[[:space:]]*(#.*)?$/ { seen = 1; next }
        /^[[:space:]]*println\([[:space:]]*("([^"\\]|\\[nt"\\])*"|-?[0-9]+|true|false|nothing|:[A-Za-z_][A-Za-z0-9_]*)([[:space:]]*,[[:space:]]*("([^"\\]|\\[nt"\\])*"|-?[0-9]+|true|false|nothing|:[A-Za-z_][A-Za-z0-9_]*))*[[:space:]]*\)[[:space:]]*(#.*)?$/ { seen = 1; next }
        { exit 1 }
        END { if (!seen) exit 1 }
    ' "$1"
}

is_print_only_file() {
    case $1 in
        *.triad|*.td) ;;
        *) return 1 ;;
    esac
    [ -f "$1" ] && [ -r "$1" ] && is_print_only_source "$1"
}

choose_profile() {
    while [ -z "$profile" ]; do
        printf '\nScegli il profilo per %s:\n' "$1"
        printf '  :core  - interprete nativo S0 (sottoinsieme Core)\n'
        printf '  :logic - motore logico S1 (fact/rule/solve)\n'
        printf '  :quit  - annulla senza eseguire\n'
        printf 'Scelta: '
        IFS= read -r choice || {
            printf '\nNessun profilo selezionato: file non eseguito.\n'
            return 1
        }
        case $choice in
            :core|core|1) profile=core ;;
            :logic|logic|2) profile=logic ;;
            :quit|quit) printf 'Esecuzione annullata.\n'; return 1 ;;
            *) printf 'Scelta non valida: digita :core o :logic.\n' ;;
        esac
    done
    printf 'Profilo %s selezionato per questa sessione.\n' "$profile"
}

run_file() {
    if [ -z "$profile" ]; then
        if [ "$#" -eq 1 ] && is_print_only_file "$1"; then
            selected=core
            printf 'Solo println di letterali: esecuzione automatica in Core.\n'
        else
            choose_profile "$1" || return 0
            selected=$profile
        fi
    else
        selected=$profile
    fi
    printf 'Profilo selezionato: %s\n' "$selected"
    if [ "$selected" = logic ]; then
        "$ROOT/bin/triad" --logic "$@"
    else
        "$ROOT/bin/triad" "$@"
    fi
    result=$?
    printf '\nProgramma terminato (codice %s, profilo %s).\n' "$result" "$selected"
    if [ "$result" -ne 0 ] && [ "$selected" = core ]; then
        printf 'Per un programma con fact/rule/solve: digita :logic, poi il percorso del file.\n'
    fi
}

printf 'Triad — sessione desktop\n'
printf 'Esecuzione di file .triad/.td; questa sessione non è un REPL.\n'
printf 'Profili: :core usa S0, :logic usa S1; solo i println di letterali sono automatici.\n'
if [ -n "$profile" ]; then
    printf 'Profilo iniziale selezionato esplicitamente: %s.\n' "$profile"
fi
if [ "$#" -gt 0 ]; then
    run_file "$@"
fi
while :; do
    printf '\nPercorso del programma (senza virgolette), :core, :logic oppure :quit: '
    IFS= read -r file || { printf '\n'; break; }
    case $file in
        :quit) break ;;
        :auto) printf 'Profilo automatico non disponibile: digita :core o :logic.\n' ;;
        :logic) profile=logic; printf 'Profilo logico S1 selezionato.\n' ;;
        :core) profile=core; printf 'Profilo Core selezionato.\n' ;;
        '') continue ;;
        *)
            # Consentiamo anche un singolo println letterale digitato al prompt,
            # senza trasformare la sessione in un REPL o eseguire codice arbitrario.
            if [ ! -e "$file" ] && printf '%s\n' "$file" | is_print_only_source -; then
                tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/triad-println.XXXXXXXX") || {
                    printf 'Impossibile creare il file temporaneo.\n' >&2
                    continue
                }
                printf '%s\n' "$file" > "$tmpdir/inline.triad"
                run_file "$tmpdir/inline.triad"
                rm -f "$tmpdir/inline.triad"
                rmdir "$tmpdir"
            else
                run_file "$file"
            fi
            ;;
    esac
done
