#!/bin/sh
# =====================================================================
#  triad-cli — CLI POSIX della toolchain Triad, SENZA Node
#
#  Pura delega (decisione "CLI e toolchain senza Node", N18,
#  .scratch/seed-linux-nativo/issues/09-cli-toolchain-senza-node.md,
#  Q1/Q4): tre sotto-comandi coprono il percorso utente —
#
#    triad-cli run <file> [-- args]    -> bin/triad
#    triad-cli test conformance|probes|all -> harness POSIX di 08
#    triad-cli status                  -> info ambiente (deterministico)
#
#  Exit code = quello del comando delegato; exit 2 = errori d'uso.
#  I comandi dev (seed generate, ai verify, ext check|package) restano
#  nella CLI Node di sviluppo: node cli/triad-cli.mjs <comando>.
#
#  Uso: triad-cli <comando> [opzioni]
# =====================================================================

set -e

# --- Risoluzione del path reale dello script (segue i symlink, best-effort) ---
self="$0"
while [ -L "$self" ]; do
    link=$(readlink "$self" 2>/dev/null) || break
    case $link in
        /*) self="$link" ;;
        *)  self="$(dirname "$self")/$link" ;;
    esac
done
ROOT=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd -P)

usage() {
    echo "uso: triad-cli <comando> [opzioni]"
    echo ""
    echo "comandi:"
    echo "  run <file> [-- args]        esegue un programma Triad (.triad/.td)"
    echo "  test conformance [--update] suite di conformità (39 casi Core)"
    echo "  test probes                 probe ok_*/test_*/bad_* + golden"
    echo "  test all                    gate completo (verify.sh)"
    echo "  status                      stato della toolchain e dell'ambiente"
    echo ""
    echo "comandi dev (richiedono Node): node cli/triad-cli.mjs <seed|ai|ext>"
}

cmd=${1:-}
[ -n "$cmd" ] || { usage >&2; exit 2; }
shift

case "$cmd" in
    run)
        [ $# -ge 1 ] || { usage >&2; exit 2; }
        file=$1
        shift
        # separatore opzionale "--" fra percorso file e argomenti del programma
        if [ "${1:-}" = "--" ]; then
            shift
        fi
        exec "$ROOT/bin/triad" "$file" "$@"
        ;;
    test)
        sub=${1:-}
        [ -n "$sub" ] || { usage >&2; exit 2; }
        shift
        case "$sub" in
            conformance)
                exec sh "$ROOT/conformance/run.sh" "$@"
                ;;
            probes)
                [ $# -eq 0 ] || { echo "triad-cli test probes: nessuna opzione prevista" >&2; exit 2; }
                exec sh "$ROOT/tests/probes/run_probes.sh"
                ;;
            all)
                [ $# -eq 0 ] || { echo "triad-cli test all: nessuna opzione prevista" >&2; exit 2; }
                exec sh "$ROOT/verify.sh"
                ;;
            *)
                echo "triad-cli test: sotto-comando sconosciuto: $sub" >&2
                usage >&2
                exit 2
                ;;
        esac
        ;;
    status)
        # Info ambiente: output deterministico, niente colori (Q1).
        seed="$ROOT/seed/linux-x86_64/seed"
        case "$(uname -s)" in
            Linux*) ;;
            *)      seed="" ;;
        esac
        echo "Triad toolchain status"
        echo "  root: $ROOT"
        echo "  system: $(uname -s) $(uname -m)"
        if [ -z "$seed" ]; then
            echo "  seed: non disponibile su questa piattaforma"
        elif [ -x "$seed" ]; then
            echo "  seed: $seed (eseguibile)"
        elif [ -f "$seed" ]; then
            echo "  seed: $seed (NON eseguibile)"
        else
            echo "  seed: non trovato (atteso: $seed)"
        fi
        case ":${PATH}:" in
            *":${HOME}/.local/bin:"*) pstate="nel PATH" ;;
            *)                        pstate="NON nel PATH" ;;
        esac
        echo "  install-path: ${HOME}/.local/bin ($pstate)"
        exit 0
        ;;
    help|-h|--help)
        usage
        exit 0
        ;;
    *)
        echo "triad-cli: comando sconosciuto: $cmd" >&2
        usage >&2
        exit 2
        ;;
esac
