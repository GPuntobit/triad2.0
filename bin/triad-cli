#!/bin/sh
# triad-cli — launcher POSIX della CLI di sviluppo (richiede Node.js >= 18).
# Uso: triad-cli <comando> [opzioni]   (es. triad-cli status)
set -e
# Risoluzione del path reale dello script (segue i symlink): il launcher può
# essere installato come link simbolico in ~/.local/bin, quindi dirname $0
# da solo non basta.
self="$0"
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self="$link" ;;
        *)  self="$(dirname "$self")/$link" ;;
    esac
done
TRIAD_HOME=$(CDPATH= cd -- "$(dirname -- "$self")/.." && pwd -P)
if ! command -v node >/dev/null 2>&1; then
    echo "triad-cli: Node.js non trovato (serve Node.js >= 18)." >&2
    exit 1
fi
if [ ! -d "$TRIAD_HOME/cli/node_modules" ]; then
    echo "triad-cli: installo le dipendenze (npm install in cli/)..." >&2
    if ! (cd "$TRIAD_HOME/cli" && npm install --silent) >&2; then
        echo "triad-cli: npm install fallito." >&2
        rm -rf "$TRIAD_HOME/cli/node_modules"
        exit 1
    fi
fi
TRIAD_HOME="$TRIAD_HOME" exec node "$TRIAD_HOME/cli/triad-cli.mjs" "$@"
