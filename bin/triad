#!/bin/sh
# =====================================================================
#  triad — launcher POSIX per il linguaggio Triad
#
#  Cerca un runtime Triad in questo ordine:
#    1. bin/triad-native  (eseguibile standalone per il sistema corrente)
#    2. seed/<piattaforma>/seed  (interprete Triad-Core in codice macchina)
#
#  Non dipende da Julia né da altri linguaggi ospiti: l'esecuzione del
#  codice .triad avviene tramite il seed in codice macchina.
#
#  Uso:  triad [opzioni] [file.td [argomenti...]]
#        triad --help          tutte le opzioni
#
#  Per usarlo da ovunque: aggiungere questa cartella al PATH, oppure
#  creare un link simbolico in ~/.local/bin/triad.
#
#  I file .td possono essere resi eseguibili direttamente:
#    chmod +x programma.td
#    ./programma.td arg1 arg2
#  purché la prima riga sia:  #!/usr/bin/env triad
# =====================================================================

set -e

# --- Risoluzione del path reale dello script (segue i symlink) --------
self="$0"
while [ -L "$self" ]; do
    link=$(readlink "$self")
    case $link in
        /*) self="$link" ;;
        *)  self="$(dirname "$self")/$link" ;;
    esac
done
TRIAD_HOME="$(cd "$(dirname "$self")/.." && pwd)"

# --- Modalità --build (strumento di sviluppo, richiede Julia) -------
if [ "${1:-}" = "--build" ]; then
    shift
    echo "triad --build: strumento di sviluppo; richiede Julia e PackageCompiler." >&2
    echo "Per l'esecuzione normale usa il seed in codice macchina (nessuna dipendenza)." >&2
    exit 2
fi

# --- Ricerca del runtime ----------------------------------------------
RUNTIME=""
SEED=""

# 1. Eseguibile standalone (nessuna dipendenza)
if [ -x "$TRIAD_HOME/bin/triad-native" ]; then
    RUNTIME="standalone"
fi

# 2. Seed in codice macchina (interprete Triad-Core)
if [ -z "$RUNTIME" ]; then
    case "$(uname -s)" in
        Linux*)  SEED_CAND="$TRIAD_HOME/seed/linux-x86_64/seed" ;;
        *)       SEED_CAND="" ;;
    esac
    if [ -n "$SEED_CAND" ] && [ -x "$SEED_CAND" ]; then
        SEED="$SEED_CAND"
        RUNTIME="seed"
    fi
fi

# --- Esecuzione -------------------------------------------------------
case "$RUNTIME" in
    standalone)
        exec "$TRIAD_HOME/bin/triad-native" "$@"
        ;;
    seed)
        exec "$SEED" "$@"
        ;;
    *)
        echo "triad: runtime non trovato." >&2
        echo "" >&2
        echo "Opzioni:" >&2
        echo "  1. Decodifica il seed in codice macchina:" >&2
        echo "     Linux:  xxd -r -p seed/linux-x86_64/seed.hex > seed/linux-x86_64/seed && chmod +x seed/linux-x86_64/seed" >&2
        echo "  2. Compila uno standalone (strumento di sviluppo): triad --build (richiede Julia)" >&2
        echo "" >&2
        echo "Triad non dipende da Julia per l'esecuzione del codice .triad." >&2
        exit 1
        ;;
esac

