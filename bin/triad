#!/bin/sh
# =====================================================================
#  triad — launcher POSIX per il linguaggio Triad
#
#  Esegue SEMPRE il seed in codice macchina (exec-sempre-il-seed):
#  nessun ramo JS, nessuna soglia stub, nessun flag --jsref, nessun
#  artefatto opzionale devia il runtime — come da decisione
#  "CLI e toolchain senza Node" (N18,
#  .scratch/seed-linux-nativo/issues/09-cli-toolchain-senza-node.md,
#  Q2) e "Installazione e launcher" (07, Q9: la logica di stub esce).
#
#  Uso:  triad programma.td [argomenti...]
#
#  Runtime: seed/<piattaforma>/seed (interprete Triad-Core in codice
#  macchina). TRIAD_SEED consente di forzare un seed specifico (usato
#  anche dalla CI e dagli harness). Nessuna dipendenza da Node, Julia o
#  altri host language.
#
#  Per usarlo da ovunque: ./install.sh (wrapper in ~/.local/bin), oppure
#  aggiungere questa cartella al PATH.
#
#  I file .td possono essere resi eseguibili direttamente:
#    chmod +x programma.td
#    ./programma.td arg1 arg2
#  purché la prima riga sia:  #!/usr/bin/env triad
# =====================================================================

set -e

# --- Risoluzione del path reale dello script (segue i symlink, best-effort) ---
self="$0"
while [ -L "$self" ]; do
    link=$(readlink "$self" 2>/dev/null) || break
    case $link in
        /*) self="$link" ;;
        *)  self="$(dirname "$self")/$link" ;;
    esac
done
TRIAD_HOME="$(cd "$(dirname "$self")/.." && pwd)"

# Explicit S1 logic profile; the regular Core path remains native S0.
if [ "${1:-}" = "--logic" ]; then
    shift
    exec sh "$TRIAD_HOME/scripts/run-logic.sh" "$@"
fi

# --- Ricerca del seed (unico runtime ammesso) -----------------------
# TRIAD_SEED permette di forzare un seed specifico (usato anche dalla CI).
if [ -n "${TRIAD_SEED:-}" ]; then
    SEED="$TRIAD_SEED"
else
    case "$(uname -s)" in
        Linux*)  SEED="$TRIAD_HOME/seed/linux-x86_64/seed" ;;
        *)       SEED="" ;;
    esac
fi

if [ -z "$SEED" ] || [ ! -x "$SEED" ]; then
    echo "triad: seed in codice macchina non trovato o non eseguibile." >&2
    if [ -n "$SEED" ]; then
        echo "  atteso: $SEED" >&2
    fi
    echo "" >&2
    echo "  Esegui ./install.sh dalla radice del repository: decodifica" >&2
    echo "  seed.hex e installa i launcher. Oppure decodifica manualmente:" >&2
    echo "    sh install.sh   (vedi seed/linux-x86_64/README.md)" >&2
    exit 1
fi

# --- Esecuzione: pura delega al seed --------------------------------
exec "$SEED" "$@"
