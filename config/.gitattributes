# Normalize line endings: conformance contract is byte-for-byte.
* text=auto
# Triad sources: .triad is canonical, .td is the historical alias.
# linguist-language prepares recognition on GitHub (see editors/linguist/).
*.triad text eol=lf linguist-language=Triad
*.td text eol=lf linguist-language=Triad
*.jl text eol=lf
*.md text eol=lf
*.cmd text eol=crlf
*.sh text eol=lf
*.vim text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.js text eol=lf
*.hex text eol=lf
*.exe binary
conformance/**/expected.out text eol=lf
conformance/**/expected.code text eol=lf
conformance/**/args.txt text eol=lf
# -----------------------------------------------------------------------------
# Explicit LF forcing for text sources without extension or by folder.
# Redundant with rules by extension, but makes the contract
# explicit: Prevent a Windows checkout from introducing CRLF into source.
# -----------------------------------------------------------------------------
bin/triad text eol=lf
editors/** text eol=lf
# -----------------------------------------------------------------------------
# Seed artifacts: should NEVER be normalized (byte-for-byte canonical source).
# seed.exe is binary; the .hex dump is treated as binary (-diff) so the
# cross-platform EOL conversions do not alter bytes or produce diff noise.
# These rules are placed at the bottom to override "*.hex text eol=lf".
# -----------------------------------------------------------------------------
seed/**/seed.exe binary
seed/**/seedbinary
seed/**/*.hex binary -diff