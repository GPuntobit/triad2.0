# TRID Native Core: certified Triad-Core subset (no return, no string ==).
# POSIX transport stages fixture.txt and journal.log in the process cwd.

function need(ok, msg)
    if !ok
        println("TRID error: " * msg)
        exit(1)
    end
    ok
end

function same(a, b)
    sa = string(a)
    sb = string(b)
    good = strlen(sa) == strlen(sb)
    i = 1
    while i <= strlen(sa) && good == true
        if strbyte(sa, i) != strbyte(sb, i)
            good = false
        end
        i += 1
    end
    good
end

function valid_name(s)
    good = strlen(s) > 0
    i = 1
    while i <= strlen(s) && good == true
        c = strbyte(s, i)
        if i == 1 && !(c >= 97 && c <= 122)
            good = false
        end
        if !((c >= 97 && c <= 122) || (c >= 48 && c <= 57) || c == 95)
            good = false
        end
        i += 1
    end
    good
end

function parse_text(src)
    rows = []
    fields = []
    start = 1
    i = 1
    n = strlen(src)
    while i <= n + 1
        ch = 10
        if i <= n
            ch = strbyte(src, i)
        end
        if ch == 124 || ch == 10
            part = ""
            if i > start
                part = strsub(src, start, i - 1)
            end
            push!(fields, part)
            start = i + 1
            if ch == 10
                if length(fields) > 1 || !same(fields[1], "")
                    push!(rows, fields)
                end
                fields = []
            end
        else
            need(ch >= 32 && ch <= 126, "invalid input byte")
        end
        i += 1
    end
    rows
end

function join_parts(xs, a, b)
    result = ""
    i = a
    while i <= b
        if i > a
            result = result * "|"
        end
        result = result * xs[i]
        i += 1
    end
    result
end

function checksum(s)
    h = 0
    i = 1
    while i <= strlen(s)
        h = (h * 131 + strbyte(s, i)) % 1000000007
        i += 1
    end
    h
end

function check_journal(rows)
    previous = 0
    i = 1
    while i <= length(rows)
        r = rows[i]
        need(length(r) >= 6, "invalid journal")
        need(same(r[1], i), "journal sequence mismatch")
        need(same(r[2], previous), "journal predecessor mismatch")
        body = join_parts(r, 1, length(r) - 1)
        current = checksum(body)
        need(same(r[length(r)], current), "journal checksum mismatch")
        previous = current
        i += 1
    end
    previous
end

function has_record(rows, body)
    found = false
    i = 1
    while i <= length(rows)
        r = rows[i]
        if length(r) >= 6
            if same(join_parts(r, 3, length(r) - 1), body)
                found = true
            end
        end
        i += 1
    end
    found
end

function has_line(lines, line)
    found = false
    i = 1
    while i <= length(lines)
        if same(lines[i], line)
            found = true
        end
        i += 1
    end
    found
end

function queue(lines, history, body)
    if !has_record(history, body) && !has_line(lines, body)
        push!(lines, body)
    end
    lines
end

function emit(lines, history)
    prev = check_journal(history)
    seq = length(history) + 1
    i = 1
    while i <= length(lines)
        line = string(seq) * "|" * string(prev) * "|" * lines[i]
        prev = checksum(line)
        println(line * "|" * string(prev))
        seq += 1
        i += 1
    end
    seq
end

function validate_data(data)
    i = 1
    while i <= length(data)
        r = data[i]
        size = length(r)
        key = r[1]
        ok = (same(key, "edge") && size == 6) || (same(key, "target") && size == 4) || (same(key, "review") && size == 7) || (same(key, "definition") && size == 6) || (same(key, "approve") && size == 4) || (same(key, "revoke") && size == 2)
        need(ok, "invalid fixture record")
        j = 2
        while j <= size
            need(valid_name(r[j]), "invalid fixture atom")
            j += 1
        end
        if same(key, "review")
            need(same(r[3], "train") || same(r[3], "test"), "invalid split")
            need(same(r[4], "positive") || same(r[4], "negative"), "invalid polarity")
        end
        i += 1
    end
    length(data)
end

function edge_exists(data, domain, relation, triple)
    found = false
    i = 1
    while i <= length(data)
        r = data[i]
        if same(r[1], "edge") && same(r[2], domain) && same(r[3], relation) && same(r[4], triple[1]) && same(r[5], triple[2]) && same(r[6], triple[3])
            found = true
        end
        i += 1
    end
    found
end

function is_revoked(data, source)
    found = false
    i = 1
    while i <= length(data)
        r = data[i]
        if same(r[1], "revoke") && same(r[2], source)
            found = true
        end
        i += 1
    end
    found
end

function read_data()
    println("NATIVE INPUT START")
    data = parse_text(trid_fixture)
    println("NATIVE FIXTURE READ")
    history = parse_text(trid_journal)
    println("NATIVE JOURNAL READ")
    validate_data(data)
    println("NATIVE FIXTURE VALID")
    check_journal(history)
    println("NATIVE JOURNAL VALID")
    result = [data, history]
    result
end
