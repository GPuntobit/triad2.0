# Durable source-labelled graph for TRID-Core 0.6.
# Keep cognitive assertions, associations and revocations separate.
fact evidence(:trid, :alpha, :src_a)
fact evidence(:alpha, :beta, :src_b)
fact evidence(:beta, :gamma, :src_c)
fact evidence(:gamma, :delta, :src_d)
fact evidence(:delta, :deep5, :src_e)
fact evidence(:trid, :xnode, :src_f)
fact evidence(:xnode, :ynode, :src_g)
fact evidence(:ynode, :deep5, :src_h)
fact revoked(:src_b)
fact association(:trid, :alpha)
fact association(:alpha, :beta)
fact association(:beta, :gamma)
fact association(:gamma, :delta)
fact association(:delta, :deep5)
fact association(:trid, :xnode)
fact association(:xnode, :ynode)
fact association(:ynode, :deep5)
fact association(:deep5, :trid)
fact rule_state(:path_generalization, :experimental)
