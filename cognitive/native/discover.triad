# TRID Native discovery: four finite Horn-rule shapes and explicit reviews.
# Append after common.triad; do not use non-certified Core "return".

function bind_pair(a, b, shape)
    x = ""
    y = ""
    z = ""
    matched = false
    if same(shape, "chain")
        matched = same(a[5], b[4])
        x = a[4]
        y = a[5]
        z = b[5]
    elseif same(shape, "reverse_chain")
        matched = same(a[4], b[5])
        x = a[5]
        y = a[4]
        z = b[4]
    elseif same(shape, "common_source")
        matched = same(a[4], b[4])
        x = a[5]
        y = a[4]
        z = b[5]
    elseif same(shape, "common_target")
        matched = same(a[5], b[5])
        x = a[4]
        y = a[5]
        z = b[4]
    end
    result = []
    if matched && !same(x, z)
        result = [x, z, y, a[6], b[6]]
    end
    result
end

function same_proof(a, b)
    equal = length(a) == length(b)
    i = 1
    while i <= length(a) && equal == true
        if !same(a[i], b[i])
            equal = false
        end
        i += 1
    end
    equal
end

function enumerate(data, target, shape)
    results = []
    i = 1
    while i <= length(data)
        a = data[i]
        if same(a[1], "edge") && same(a[2], target[2]) && same(a[3], target[4])
            j = 1
            while j <= length(data)
                b = data[j]
                if same(b[1], "edge") && same(b[2], target[2]) && same(b[3], target[4])
                    p = bind_pair(a, b, shape)
                    if length(p) == 5
                        found = false
                        k = 1
                        while k <= length(results)
                            if same_proof(results[k], p)
                                found = true
                            end
                            k += 1
                        end
                        if !found
                            need(length(results) < 60, "candidate limit")
                            push!(results, p)
                        end
                    end
                end
                j += 1
            end
        end
        i += 1
    end
    results
end

function pair_present(proofs, x, z)
    found = false
    i = 1
    while i <= length(proofs)
        p = proofs[i]
        if same(p[1], x) && same(p[2], z)
            found = true
        end
        i += 1
    end
    found
end

function review_counts(data, name, mode, proofs)
    hits = 0
    total = 0
    i = 1
    while i <= length(data)
        r = data[i]
        if same(r[1], "review") && same(r[2], name) && same(r[3] * r[4], mode)
            total += 1
            if pair_present(proofs, r[5], r[6])
                hits += 1
            end
        end
        i += 1
    end
    result = [hits, total]
    result
end

function metrics(data, target, shape)
    proofs = enumerate(data, target, shape)
    trainpos = review_counts(data, target[3], "trainpositive", proofs)
    trainneg = review_counts(data, target[3], "trainnegative", proofs)
    testpos = review_counts(data, target[3], "testpositive", proofs)
    testneg = review_counts(data, target[3], "testnegative", proofs)
    tp = trainpos[1]
    fp = trainneg[1]
    fn = trainpos[2] - tp
    ttp = testpos[1]
    tfp = testneg[1]
    tfn = testpos[2] - ttp
    score = 3 * tp - 5 * fp - 2 * fn
    state = "experimental"
    if fp > 0 || tfp > 0
        state = "refuted"
    end
    result = [shape, tp, fp, fn, ttp, tfp, tfn, score, state, proofs]
    result
end

function candidate_event(target, c, selected)
    "evaluation|" * target[3] * "|" * c[1] * "|" * c[9] * "|" * string(c[2]) * "|" * string(c[3]) * "|" * string(c[4]) * "|" * string(c[5]) * "|" * string(c[6]) * "|" * string(c[7]) * "|" * string(c[8]) * "|" * selected
end

function selected_candidate(candidates)
    best = 1
    i = 2
    while i <= length(candidates)
        if candidates[i][8] > candidates[best][8]
            best = i
        end
        i += 1
    end
    best
end

function discover_target(data, target, journal, events)
    shapes = ["chain", "common_source", "common_target", "reverse_chain"]
    candidates = []
    i = 1
    while i <= length(shapes)
        println("NATIVE SHAPE ", shapes[i])
        push!(candidates, metrics(data, target, shapes[i]))
        i += 1
    end
    best = selected_candidate(candidates)
    i = 1
    while i <= length(candidates)
        c = candidates[i]
        selected = "no"
        if i == best && c[2] > 0 && c[3] == 0
            selected = "yes"
        end
        queue(events, journal, candidate_event(target, c, selected))
        if same(selected, "yes") && !same(c[9], "refuted")
            proofs = c[10]
            j = 1
            while j <= length(proofs)
                p = proofs[j]
                body = "proof|" * target[3] * "|" * c[1] * "|" * p[1] * "|" * p[2] * "|" * p[3] * "|" * p[4] * "|" * p[5]
                queue(events, journal, body)
                j += 1
            end
        end
        i += 1
    end
    events
end

println("BEGIN 1")
data = parse_file("fixture.txt")
println("BEGIN 2 ", length(data))
journal = parse_file("journal.log")
println("BEGIN 3")
validate_data(data)
check_journal(journal)
println("BEGIN 4")
events = []
i = 1
while i <= length(data)
    row = data[i]
    println("ROW ", i)
    if same(row[1], "target")
        println("TARGET ", row[3])
        discover_target(data, row, journal, events)
    end
    i += 1
end
emit(events, journal)
