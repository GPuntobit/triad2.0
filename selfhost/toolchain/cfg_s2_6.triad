# TRIAD S2.6 independent fixed-point CFG verifier for multiple functions.
# Each lexical function (and _start) has its own root and stack bitmask.
# No host-language parsing or JavaScript. Unit scan and must-def solver share
# one Triad S0 function frame, avoiding nested vector reallocation limits.
# Requires cfg_s2_5.triad and assembler_s2_1.triad.

function cfg26_verify(src)
    asm_need(strlen(src) > 0 && strlen(src) <= 12000)
    pos = 1
    units = 0
    while pos <= strlen(src)
        ops = []
        args = []
        done_unit = false
        while pos <= strlen(src) && !done_unit
            line_end = pos
            while line_end <= strlen(src) && strbyte(src, line_end) != 10
                line_end += 1
            end
            if line_end > pos
                words = asm_tokens(strsub(src, pos, line_end - 1))
                if !asm_same(words[1], "@")
                    asm_need(length(words) == 2 || length(words) == 3)
                    op = words[1]
                    arg = ""
                    if length(words) == 3
                        arg = words[2]
                    end
                    push!(ops, op)
                    push!(args, arg)
                    asm_need(length(ops) <= 45)
                    if asm_same(op, "exit") || asm_same(op, "return")
                        done_unit = true
                    end
                end
            end
            pos = line_end + 1
        end
        if length(ops) > 0
            n = length(ops)
            asm_need(done_unit && n >= 4)
            if units == 0
                asm_need(asm_same(ops[1], "start"))
                asm_need(asm_same(ops[n], "exit"))
            else
                asm_need(asm_same(ops[1], "label"))
                asm_need(asm_same(ops[n], "return"))
            end
            i = 1
            while i <= n
                op = ops[i]
                if asm_same(op, "jump") || asm_same(op, "br_zero") || asm_same(op, "br_nonzero")
                    asm_need(cfg25_target(ops, args, args[i]) > 0)
                end
                i += 1
            end
            old_out = []
            old_reach = []
            i = 1
            while i <= n
                push!(old_out, 255)
                push!(old_reach, false)
                i += 1
            end
            graph = [ops, args]
            stable = false
            rounds = 0
            final_in = []
            final_reach = []
            while !stable && rounds <= n + 1
                new_out = []
                new_reach = []
                new_in = []
                stable = true
                i = 1
                previous = [old_out, old_reach]
                while i <= n
                    state = cfg25_step(graph, previous, i, 1)
                    push!(new_in, state[1])
                    push!(new_out, state[2])
                    push!(new_reach, state[3])
                    if old_out[i] != state[2] || old_reach[i] != state[3]
                        stable = false
                    end
                    i += 1
                end
                old_out = new_out
                old_reach = new_reach
                final_in = new_in
                final_reach = new_reach
                rounds += 1
            end
            asm_need(stable)
            i = 1
            while i <= n
                if final_reach[i] && cfg25_read(ops[i])
                    offset = asm_uint(args[i])
                    asm_need(cfg25_known(final_in[i], offset))
                end
                i += 1
            end
            units += 1
            asm_need(units <= 4)
        end
    end
    asm_need(units >= 3 && units <= 4)
    true
end
