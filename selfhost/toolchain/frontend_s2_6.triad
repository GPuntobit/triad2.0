# TRIAD S2.6 — native multi-function, lexical i32 scopes, nested typed AST.
# Dependencies: S2.5 frontend, S2.4 lexical locals, S2.1 ELF.
# Profile: up to 3 single/two-argument functions, declared before main;
# calls inside functions only to earlier declarations (acyclic call graph).
# Recursive functions have a separate, statically checked profile.
# Every function and top-level owns a distinct fixed native stack frame.
# Internal slots 28..31 reserved for nested expression temporary storage.

function f26_atom(word)
    node = []
    if mv_number(word)
        asm_uint(word)
        push!(node, "const")
    else
        asm_need(f25_name(word))
        push!(node, "var")
    end
    push!(node, "i32")
    push!(node, word)
    node
end

# Expression AST: left-associative single binary or one nested RHS group.
# e.g. a + (b - 2) gives [binary,i32,[var,i32,a],+,
#                              [binary,i32,[var,i32,b],-,[const,i32,2]]].
function f26_expr(words, first, last)
    count = last - first + 1
    node = []
    if count == 7
        lhs = f26_atom(words[first])
        operation = words[first + 1]
        asm_need(asm_same(operation, "+") || asm_same(operation, "-"))
        asm_need(asm_same(words[first + 2], "("))
        inner_lhs = f26_atom(words[first + 3])
        inner_op = words[first + 4]
        asm_need(asm_same(inner_op, "+") || asm_same(inner_op, "-"))
        inner_rhs = f26_atom(words[first + 5])
        asm_need(asm_same(words[first + 6], ")"))
        inner = ["binary", "i32", inner_lhs, inner_op, inner_rhs]
        node = ["binary", "i32", lhs, operation, inner]
    else
        basic = f25_expr(words, first, last)
        kind = basic[1]
        if asm_same(kind, "binary")
            lhs = f26_atom(basic[3])
            rhs = f26_atom(basic[5])
            node = ["binary", "i32", lhs, basic[4], rhs]
        elseif asm_same(kind, "const") || asm_same(kind, "var")
            node = f26_atom(basic[3])
        else
            asm_need(asm_same(kind, "call"))
            node = basic
        end
    end
    node
end

# The flattened signature table stores [name, arity, name, arity, ...].
function f26_arity(signatures, wanted)
    result = 0
    i = 1
    while i <= length(signatures)
        if asm_same(signatures[i], wanted)
            result = signatures[i + 1]
        end
        i += 2
    end
    result
end

# Env: [locals, definite-mask, visible-signatures, current-function-name].
# Reads resolve only within this lexical environment; globals and other
# functions' locals cannot be accessed implicitly.
function f26_emit(ir, node, env)
    kind = node[1]
    asm_need(asm_same(node[2], "i32"))
    vars = env[1]
    mask = env[2]
    out = ir
    if asm_same(kind, "binary")
        left = node[3]
        operation = node[4]
        right = node[5]
        asm_need(asm_same(left[2], "i32") && asm_same(right[2], "i32"))
        if asm_same(right[1], "binary")
            inner_left = right[3]
            inner_op = right[4]
            inner_right = right[5]
            asm_need(!asm_same(inner_left[1], "binary"))
            asm_need(!asm_same(inner_right[1], "binary"))
            out = mv_value(out, vars, mask, inner_left[3])
            out = mv_arithmetic(out, vars, mask, inner_op * inner_right[3])
            out = front_line(out, "i32_store 28")
            out = mv_value(out, vars, mask, left[3])
            if asm_same(operation, "+")
                out = front_line(out, "i32_add_slot 28")
            else
                out = front_line(out, "i32_sub_slot 28")
            end
        else
            out = mv_value(out, vars, mask, left[3])
            out = mv_arithmetic(out, vars, mask, operation * right[3])
        end
    elseif asm_same(kind, "call")
        function_name = node[3]
        first = node[4]
        second = node[5]
        arity = f26_arity(env[3], function_name)
        asm_need(arity == 1 || arity == 2)
        asm_need(!asm_same(function_name, env[4]))
        if arity == 1
            asm_need(strlen(second) == 0)
        else
            asm_need(strlen(second) > 0)
        end
        out = mv_value(out, vars, mask, first)
        if arity == 2
            out = f25_second(out, vars, mask, second)
        end
        out = front_line(out, "i32_call " * function_name)
    else
        asm_need(asm_same(kind, "const") || asm_same(kind, "var"))
        out = mv_value(out, vars, mask, node[3])
    end
    out
end

function f26_assignment(ir, words, env)
    asm_need(length(words) >= 3 && asm_same(words[2], "="))
    dest = words[1]
    asm_need(f25_name(dest))
    vars = env[1]
    mask = env[2]
    # Never use the reserved stack slot 28 for a source local.
    println("S26-AST-START")
    node = f26_expr(words, 3, length(words))
    println("S26-AST-READY")
    out = f26_emit(ir, node, env)
    println("S26-LOWERED")
    slot = mv_allocate(vars, dest)
    asm_need(slot <= 24)
    out = front_line(out, "i32_store " * string(slot))
    mask = mv_mark(mask, slot)
    println("S26-STORED")
    [out, mask]
end

# More than one function may define the same local names (lexical isolation).
# The function code is concatenated after the top-level exit so each call
# retains the x86-64 stack and EAX result ABI from S2.5.
function source_to_ir26(src)
    asm_need(strlen(src) > 0 && strlen(src) <= 8000)
    main_ir = "start"
    main_ir = front_line(main_ir, "i32_frame 32")
    bodies = ""
    body = ""
    symbols = []
    globals = []
    signatures = []
    mask = 0
    global_mask = 0
    current_name = ""
    state = 0
    arity = 0
    completed_function = false
    finished = false
    saw_call = false
    defs = 0
    statements = 0
    pos = 1
    while pos <= strlen(src)
        line_end = pos
        while line_end <= strlen(src) && strbyte(src, line_end) != 10
            line_end += 1
        end
        if line_end > pos
            words = f25_words(strsub(src, pos, line_end - 1))
            if length(words) > 0
                op = words[1]
                println("S26-LINE")
                println(op)
                asm_need(!finished)
                if asm_same(op, "function")
                    asm_need(state == 0 && !completed_function)
                    asm_need(length(words) == 5 || length(words) == 7)
                    name = words[2]
                    asm_need(f25_name(name) && f26_arity(signatures, name) == 0)
                    asm_need(asm_same(words[3], "("))
                    asm_need(asm_same(words[length(words)], ")"))
                    first_param = words[4]
                    asm_need(f25_name(first_param))
                    defs += 1
                    asm_need(defs <= 3)
                    arity = 1
                    if length(words) == 7
                        asm_need(asm_same(words[5], ","))
                        second_param = words[6]
                        asm_need(f25_name(second_param) && !asm_same(first_param, second_param))
                        arity = 2
                    end
                    # Append this declaration only after its own body is
                    # parsed: function bodies can call earlier declarations,
                    # never unknown names, themselves or later functions.
                    current_name = name
                    symbols = []
                    mask = 0
                    body = front_line(body, "label " * current_name)
                    body = front_line(body, "i32_enter 40")
                    first_slot = mv_allocate(symbols, first_param)
                    asm_need(first_slot == 0)
                    body = front_line(body, "i32_store 0")
                    mask = mv_mark(mask, 0)
                    if arity == 2
                        second_slot = mv_allocate(symbols, second_param)
                        asm_need(second_slot == 4)
                        body = front_line(body, "i32_arg2_store 4")
                        mask = mv_mark(mask, 4)
                    end
                    state = 1
                elseif state == 1
                    if asm_same(op, "end")
                        asm_need(completed_function && length(words) == 1)
                        bodies = front_line(bodies, body)
                        body = ""
                        push!(signatures, current_name)
                        push!(signatures, arity)
                        completed_function = false
                        state = 0
                    elseif length(words) == 1 || asm_same(op, "return")
                        asm_need(!completed_function)
                        result_name = op
                        if asm_same(op, "return")
                            asm_need(length(words) == 2)
                            result_name = words[2]
                        end
                        offset = mv_require(symbols, mask, result_name)
                        body = front_line(body, "i32_load " * string(offset))
                        body = front_line(body, "i32_result")
                        body = front_line(body, "i32_leave 40")
                        body = front_line(body, "return")
                        completed_function = true
                    else
                        asm_need(!completed_function)
                        env = [symbols, mask, signatures, current_name]
                        pair = f26_assignment(body, words, env)
                        body = pair[1]
                        mask = pair[2]
                    end
                elseif asm_same(op, "exit")
                    asm_need(state == 0 && defs >= 2)
                    asm_need(length(words) == 4)
                    asm_need(asm_same(words[2], "(") && asm_same(words[4], ")"))
                    slot = mv_require(globals, global_mask, words[3])
                    main_ir = front_line(main_ir, "i32_load " * string(slot))
                    main_ir = front_line(main_ir, "exit")
                    finished = true
                else
                    asm_need(state == 0 && defs >= 2)
                    asm_need(length(words) >= 3)
                    node = f26_expr(words, 3, length(words))
                    if asm_same(node[1], "call")
                        saw_call = true
                    end
                    env = [globals, global_mask, signatures, ""]
                    pair = f26_assignment(main_ir, words, env)
                    main_ir = pair[1]
                    global_mask = pair[2]
                end
                statements += 1
                asm_need(statements <= 42 && strlen(main_ir) + strlen(bodies) + strlen(body) <= 11000)
            end
        end
        pos = line_end + 1
    end
    asm_need(state == 0 && finished && completed_function == false)
    asm_need(defs >= 2 && saw_call)
    front_line(main_ir, bodies)
end
