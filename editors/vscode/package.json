          "triad"
        ],
        "extensions": [
          ".triad",
          ".td"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "triad",
        "scopeName": "source.triad",
        "path": "./syntaxes/triad.tmLanguage.json"
      }
    ]
