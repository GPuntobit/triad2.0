{
  "name": "triad",
  "displayName": "Triad",
  "description": "Supporto editor per il linguaggio Triad: sintassi, commenti, parentesi",
  "version": "0.2.0",
  "publisher": "triad-lang",
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "triad",
    "language",
    "prolog",
    "lisp",
    "julia"
  ],
  "contributes": {
