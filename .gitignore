!conformance/**/expected.out
!conformance/**/expected.code
!ai/**/expected.out

# Python virtualenv
.venv/

# Graphify (generated: `graphify update .`)
graphify-out/
graphify.skill

# Local scratch scripts and standalone drafts (root only)
/_*.mjs
/_*.js
/curva-apprendimento-triad.html

# Command output captures (root only)
/runoutput.txt
/stdout.txt
/scope_out.txt
/test_output.txt
/out.txt
/output.txt
/outfile.txt
/error.txt
/let_*out*.txt
/0

# Agent/IDE local state
.kiro/settings/*.lock


#Ignore vscode AI rules
.github\instructions\codacy.instructions.md

# Git credentials (token GitHub) - NON committare
.git-credentials

# Pacchetti estensione editor
*.vsix

# Bundle browser del playground, generato da scripts/docs/sync-playground-core.mjs
docs/pages/triad-core.js

# Bundle browser dell'interprete, generato da scripts/docs/build-triad-core.mjs
docs/assets/js/triad-core.js

# Libro: tutti i file di produzione del libro (pdf/epub/mobi/docx/html, script e temp)
# libro/ contiene i sorgenti e gli strumenti locali del libro
/libro/
# docs/libro è un repo separato (ha il proprio .git) per la pubblicazione del libro
/docs/libro/

# Installer smoke golden
!tests/probes/test_simple.expected.out
