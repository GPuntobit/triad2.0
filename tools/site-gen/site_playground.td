println("<article class='doc-content'>")
println("<h1>Playground</h1>")
println("<p>Write a Triad program and press Run: the Triad-Core interpreter runs inside the browser and prints its output right below the editor.</p>")
println("<p class='generated-by'>This page is generated by a Triad program (tools/site-gen/site_playground.td).</p>")
println("<div class='pg-wrap'>")
println("<div class='pg-actions'>")
println("<div class='pg-examples'>")
println("<label for='pg-example'>Examples</label>")
println("<select id='pg-example'></select>")
println("</div>")
println("<button id='pg-run' class='btn btn-primary' type='button'>Run</button>")
println("<span id='pg-status' class='pg-status'>Ready</span>")
println("</div>")
println("<textarea id='pg-editor' class='pg-editor' spellcheck='false' autocomplete='off' autocapitalize='off' autocorrect='off'></textarea>")
println("<pre id='pg-output' class='pg-output'></pre>")
println("</div>")
println("<h2>How to use</h2>")
println("<ul>")
println("<li>Type your program in the editor: the panel starts with the Welcome example.</li>")
println("<li>Press <strong>Run</strong> to execute it, or use Ctrl+Enter (Cmd+Enter on macOS) from inside the editor.</li>")
println("<li>Pick another program from the <strong>Examples</strong> menu to load it into the editor.</li>")
println("<li>Stdout and stderr land in the output panel. When the program fails, the panel turns red and shows the error message.</li>")
println("</ul>")
println("<blockquote>The code runs on a Triad-Core interpreter compiled to JavaScript. Nothing is sent to a server: the program never leaves the page.</blockquote>")
println("<h2>Example programs</h2>")
println("<h3>Functions, short form and recursion</h3>")
println("<pre class='code-card'>sum(a, b) = a + b")
println("square(x) = x * x")
println("println(sum(2, 3))")
println("println(square(4))")
println("")
println("factorial(n) = n &lt; 2 ? 1 : n * factorial(n - 1)")
println("fib(n) = n &lt; 2 ? n : fib(n - 1) + fib(n - 2)")
println("println(factorial(5))")
println("println(fib(10))</pre>")
println("<h3>Lambdas and closures</h3>")
println("<pre class='code-card'>double = x -&gt; x * 2")
println("apply = f -&gt; f(3)")
println("println(double(5))")
println("println(apply(x -&gt; x * x))")
println("")
println("function add(n)")
println("  x -&gt; x + n")
println("end")
println("f = add(10)")
println("println(f(5))</pre>")
println("<h3>Lists and push!</h3>")
println("<pre class='code-card'>lst = []")
println("lst = push!(lst, 10)")
println("lst = push!(lst, 20)")
println("println(lst)")
println("println(length(lst))</pre>")
println("<h3>Control flow</h3>")
println("<pre class='code-card'>x = 0")
println("while x &lt; 3")
println("  println(x)")
println("  x += 1")
println("end")
println("")
println("if x == 3")
println("  println(&quot;three&quot;)")
println("elseif x &gt; 3")
println("  println(&quot;more&quot;)")
println("else")
println("  println(&quot;minus&quot;)")
println("end</pre>")
println("<h3>Strings and symbols</h3>")
println("<pre class='code-card'>s = &quot;Triad&quot;")
println("println(strlen(s))")
println("println(strsub(s, 1, 3))")
println("println(strbyte(s, 1))")
println("")
println("p = :alice")
println("println(p)")
println("println(typeof(:sym))")
println("println(Int(&quot;42&quot;))</pre>")
println("<h2>Cheat sheet</h2>")
println("<table>")
println("<thead>")
println("<tr><th>Feature</th><th>Example</th></tr>")
println("</thead>")
println("<tbody>")
println("<tr><td>Print a line</td><td><code>println(value)</code></td></tr>")
println("<tr><td>Short function</td><td><code>f(x) = x * 2</code></td></tr>")
println("<tr><td>Block function</td><td><code>function f(x) ... end</code></td></tr>")
println("<tr><td>Lambda</td><td><code>x -&gt; x * 2</code></td></tr>")
println("<tr><td>Branch</td><td><code>if / elseif / else</code></td></tr>")
println("<tr><td>Loop</td><td><code>while cond ... end</code></td></tr>")
println("<tr><td>List push</td><td><code>push!(xs, value)</code></td></tr>")
println("<tr><td>String tools</td><td><code>strlen</code>, <code>strsub</code>, <code>strbyte</code></td></tr>")
println("<tr><td>Type of a value</td><td><code>typeof(x)</code></td></tr>")
println("<tr><td>Parse an integer</td><td><code>Int(&quot;42&quot;)</code></td></tr>")
println("<tr><td>Ternary</td><td><code>cond ? a : b</code></td></tr>")
println("</tbody>")
println("</table>")
println("<h2>The runtime bundle</h2>")
println("<p>The interpreter that runs in the browser is a generated artifact: it is built from <code>seed/dev/triad_core.cjs</code> and must never be edited by hand.</p>")
println("<pre class='code-card'>node scripts/docs/build-triad-core.mjs")
println("node scripts/docs/sync-playground-core.mjs</pre>")
