# Native Triad static documentation page: browser script runtime retired.
println("=== FILE: docs/pages/playground.html ===")
println("<!DOCTYPE html>")
println("<html lang='en'>")
println("<head>")
println("<meta charset='utf-8' />")
println("<meta name='viewport' content='width=device-width, initial-scale=1' />")
println("<title>Run Triad locally — Triad 2.0</title>")
println("<link rel='stylesheet' href='../assets/css/style.css' />")
println("<link rel='stylesheet' href='../assets/css/triad-generated.css' />")
println("</head>")
println("<body>")
println("<header class='site-header'><nav class='container'><a href='../index.html'>Triad 2.0</a> · <a href='getting-started.html'>Getting started</a> · <a href='spec.html'>Specification</a></nav></header>")
println("<main class='container'><article class='doc-content'>")
println("<h1>Run Triad natively</h1>")
println("<p>The browser playground was retired: executable Triad code runs using the native Linux x86-64 seed.</p>")
println("<pre class='code-card'>git clone https://github.com/GPuntobit/triad2.0.git")
println("cd triad2.0")
println("./install.sh")
println("./bin/triad examples/benvenuto.triad</pre>")
println("<p>Use <code>./bin/triad --logic program.triad</code> for the S1 logic profile. No browser interpreter or external scripting runtime is bundled.</p>")
println("</article></main>")
println("<footer class='site-footer'><div class='container'>Triad 2.0 · Static native-language documentation</div></footer>")
println("</body>")
println("</html>")
