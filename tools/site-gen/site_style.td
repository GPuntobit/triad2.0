# =====================================================================
# site_style.td — CSS del sito generato con Triad (Triad-Core).
#
# Emette: docs/assets/css/triad-generated.css
#
# Regole del protocollo di emissione:
#   - ogni riga del file di output e' un println separato;
#   - i letterali non contengono escape (\n non e' interpretato dal seed);
#   - nessun letterale contiene la sottostringa "if" dentro un blocco
#     (qui non ci sono blocchi: tutto e' a livello di programma);
#   - i valori CSS riprendono le variabili di docs/assets/css/style.css,
#     nessun tema parallelo.
#
# Uso:  node tools/site-gen/build.mjs tools/site-gen/site_style.td
# =====================================================================

println("=== FILE: docs/assets/css/triad-generated.css ===")
println("/* triad-generated.css - generated by tools/site-gen/site_style.td (Triad-Core). */")
println("/* Complements docs/assets/css/style.css: documentation layout + playground. */")
println("/* Do not edit by hand: regenerate with node tools/site-gen/build.mjs. */")
println(":root { --err: #f87171; --mono: 'JetBrains Mono', 'Fira Code', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; }")
println("")
println("/* ---------- documentation layout ---------- */")
println(".doc-layout { display: grid; grid-template-columns: 250px minmax(0, 1fr); gap: 40px; align-items: start; padding: 36px 0 72px; }")
println(".doc-sidebar { position: sticky; top: 84px; align-self: start; background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px 16px; }")
println(".doc-sidebar h4 { margin: 0 0 12px; font-size: .74rem; font-weight: 700; text-transform: uppercase; letter-spacing: .09em; color: var(--muted); }")
println(".doc-sidebar ul { list-style: none; margin: 0; padding: 0; }")
println(".doc-sidebar li { margin: 0 0 2px; }")
println(".doc-sidebar a { display: block; padding: 6px 10px; border-radius: 8px; color: var(--muted); font-size: .92rem; }")
println(".doc-sidebar a:hover { color: #fff; background: rgba(255,255,255,.05); text-decoration: none; }")
println(".doc-sidebar a.active { color: #fff; background: rgba(96,165,250,.14); box-shadow: inset 0 -2px 0 var(--accent); }")
println(".doc-content { min-width: 0; }")
println(".doc-content h1 { margin: 0 0 12px; font-size: 2.1rem; }")
println(".doc-content h2 { font-size: 1.5rem; margin: 34px 0 12px; padding-bottom: 8px; border-bottom: 1px solid var(--border); }")
println(".doc-content h3 { font-size: 1.12rem; margin: 24px 0 8px; color: #fff; }")
println(".doc-content p { color: var(--muted); margin: 0 0 14px; }")
println(".doc-content ul { color: var(--muted); margin: 0 0 16px; padding-left: 22px; }")
println(".doc-content li { margin: 5px 0; }")
println(".doc-content a { color: var(--accent); }")
println(".doc-content code { font-family: var(--mono); font-size: .88em; background: var(--code-bg); border: 1px solid var(--border); border-radius: 6px; padding: 1px 6px; color: #cbd5e1; }")
println(".doc-content pre { font-family: var(--mono); font-size: .85rem; line-height: 1.6; background: var(--code-bg); color: #cbd5e1; border: 1px solid var(--border); border-radius: var(--radius); padding: 20px 22px; overflow-x: auto; white-space: pre; box-shadow: var(--shadow); }")
println(".doc-content pre code { background: none; border: 0; padding: 0; font-size: 1em; }")
println(".doc-content table { width: 100%; border-collapse: collapse; margin: 0 0 22px; font-size: .93rem; }")
println(".doc-content th { text-align: left; padding: 10px 12px; background: var(--bg-soft); border: 1px solid var(--border); color: #fff; font-weight: 600; }")
println(".doc-content td { padding: 10px 12px; border: 1px solid var(--border); color: var(--muted); vertical-align: top; }")
println(".doc-content blockquote { margin: 0 0 20px; padding: 12px 18px; border-left: 3px solid var(--accent); background: var(--bg-card); border-radius: 0 var(--radius) var(--radius) 0; color: var(--muted); }")
println("")
println("/* ---------- playground ---------- */")
println(".pg-wrap { background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius); padding: 18px; box-shadow: var(--shadow); margin: 26px 0 36px; }")
println(".pg-actions { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; margin-bottom: 14px; }")
println(".pg-examples { display: inline-flex; align-items: center; gap: 8px; color: var(--muted); font-size: .88rem; font-weight: 600; }")
println(".pg-examples select { background: var(--bg-soft); color: var(--text); border: 1px solid var(--border); border-radius: 8px; padding: 8px 10px; font-family: inherit; font-size: .88rem; cursor: pointer; }")
println(".pg-examples select:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(96,165,250,.18); }")
println(".pg-editor { display: block; width: 100%; min-height: 300px; resize: vertical; background: var(--code-bg); color: #e2e8f0; border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; font-family: var(--mono); font-size: .88rem; line-height: 1.6; tab-size: 4; }")
println(".pg-editor:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px rgba(96,165,250,.18); }")
println(".pg-output { margin: 14px 0 0; min-height: 120px; max-height: 440px; overflow: auto; background: var(--code-bg); color: #cbd5e1; border: 1px solid var(--border); border-radius: 10px; padding: 14px 16px; font-family: var(--mono); font-size: .88rem; line-height: 1.6; white-space: pre-wrap; word-break: break-word; }")
println(".pg-output.err { border-color: var(--err); color: #fecaca; }")
println(".pg-status { color: var(--muted); font-size: .85rem; font-weight: 600; }")
println("")
println("/* ---------- generated-page badge ---------- */")
println(".generated-by { display: inline-flex; align-items: center; gap: 8px; margin: 0 0 26px; padding: 6px 12px; border: 1px dashed rgba(52,211,153,.45); border-radius: 999px; background: rgba(52,211,153,.08); color: var(--accent-3); font-size: .78rem; font-weight: 600; }")
println("")
println("/* ---------- responsive ---------- */")
println("@media (min-width: 1100px) {")
println("  /* la barra di navigazione ha 13 voci: compatta i link perche' entrino tutti senza scorrimento */")
println("  .nav-links { gap: 2px; }")
println("  .nav-links a { padding: 8px 7px; font-size: .85rem; }")
println("}")
println("@media (max-width: 900px) {")
println("  .doc-layout { grid-template-columns: 1fr; gap: 22px; padding: 24px 0 56px; }")
println("  .doc-sidebar { position: static; }")
println("  .doc-content h2 { font-size: 1.3rem; }")
println("}")
println("@media (max-width: 600px) {")
println("  .pg-wrap { padding: 14px; }")
println("  .pg-actions { gap: 8px; }")
println("  .pg-editor { min-height: 240px; font-size: .82rem; }")
println("  .pg-output { max-height: 320px; }")
println("}")
